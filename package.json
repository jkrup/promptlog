{
  "name": "promptlog",
  "version": "0.0.1",
  "description": "Prompt-native code review: capture AI coding conversations into git, review them, interrogate any turn.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "promptlog": "bin/promptlog"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "node --no-warnings --test 'test/**/*.test.ts' 'src/**/*.test.ts'",
    "promptlog": "node --no-warnings src/cli/main.ts",
    "eval": "node --no-warnings src/summarize/eval.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
