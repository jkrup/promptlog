{
  "name": "promptlog-viewer",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  // PUBLIC_REPOS: comma-separated repos anyone can read without the key (GET pages only, no AI).
  "vars": { "REPO": "laya-pilot", "AI_GATEWAY": "default", "PUBLIC_REPOS": "promptlog-demo" },
  "ai": { "binding": "AI" },
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "promptlog" }],
  "containers": [
    {
      "class_name": "Viewer",
      "image": "./Dockerfile",
      "image_build_context": "../..",
      "instance_type": "basic",
      "max_instances": 4
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "VIEWER", "class_name": "Viewer" },
      { "name": "LEASES", "class_name": "LeaseRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Viewer"] },
    { "tag": "v2", "new_sqlite_classes": ["LeaseRoom"] }
  ]
}
