{
  "name": "promptlog-viewer",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "vars": { "REPO": "laya-pilot", "AI_GATEWAY": "default" },
  "ai": { "binding": "AI" },
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "promptlog" }],
  "containers": [
    {
      "class_name": "Viewer",
      "image": "./Dockerfile",
      "image_build_context": "../..",
      "instance_type": "basic",
      "max_instances": 4
    }
  ],
  "durable_objects": { "bindings": [{ "name": "VIEWER", "class_name": "Viewer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Viewer"] }]
}
